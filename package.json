{
  "name": "log-ingestion-service",
  "version": "1.0.0",
  "description": "High-throughput log ingestion and query service",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "test:unit": "node scripts/run-unit-tests.js",
    "test:contract": "bash scripts/contract-smoke-test.sh",
    "test": "npm run typecheck && npm run test:unit",
    "benchmark": "node benchmark.js",
    "loadtest": "docker-compose down -v && docker-compose up --build -d && node benchmark.js"
  },
  "dependencies": {
    "fastify": "^4.26.0",
    "pg": "^8.11.3",
    "pg-copy-streams": "^6.0.6"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/pg": "^8.11.0",
    "@types/pg-copy-streams": "^1.2.5",
    "autocannon": "^7.14.0",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
